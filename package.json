{
  "name": "casa-finance",
  "private": true,
  "version": "1.0.0",
  "description": "Controle financeiro local para duas pessoas acompanharem a compra/montagem da casa.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "migrate": "npm run migrate --workspace server",
    "seed:categories": "npm run seed:categories --workspace server",
    "create:users": "npm run create:users --workspace server",
    "backup": "npm run backup --workspace server",
    "start": "npm run build && npm run start --workspace server",
    "test": "npm run test --workspace server"
  }
}
