# Copie para .env dentro da pasta de deploy na VM (ex.: ~/casa-finance/.env)

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/casa-finance.db
BACKUP_DIR=./backups
BACKUP_RETENTION=30

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria

# Domínio público apontando para o IP da VM (ex.: gratuito via DuckDNS).
# Usado pelo Caddy para emitir o certificado HTTPS automaticamente.
DOMAIN=seu-app.duckdns.org

# Imagem publicada pelo GitHub Actions (ghcr.io/<usuario>/<repositorio>).
# Use tudo em minúsculas.
GHCR_IMAGE=ghcr.io/seu_usuario/casa-finance
