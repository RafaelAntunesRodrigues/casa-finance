NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Caminho do banco SQLite (persistente, deve sobreviver a rebuild/restart)
DATABASE_PATH=./data/casa-finance.db

# String longa e aleatoria usada para assinar o cookie de sessao.
# Gere uma nova com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria

# Backup
BACKUP_DIR=./backups
BACKUP_RETENTION=30

# Usados apenas pelo script server/scripts/create-users.js para provisionar os
# dois usuarios iniciais sem senha hardcoded no codigo. Pode tambem ser
# informado interativamente ao rodar o script sem essas variaveis.
USER1_NAME=Rafael
USER1_USERNAME=rafael
USER1_PASSWORD=
USER2_NAME=Pessoa 2
USER2_USERNAME=pessoa2
USER2_PASSWORD=
